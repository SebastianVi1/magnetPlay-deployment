# Production environment file for docker-compose.prod.yml
# WARNING: This file contains credentials. Keep it private and out of public repos.

# Image tag injected when building/pushing (use CI to set TAG)
TAG=latest

# Postgres / Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123sebass
POSTGRES_DB=magnetPlay

# Spring backend datasource (Spring will read these or you may map separately)
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/${POSTGRES_DB}
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# Vite frontend environment (used at build time inside the frontend Dockerfile)
# For production, set these to the public domain/IP where the services will be reachable from the browser.
VITE_API_URL=http://143.198.155.67:8080
VITE_STREAMING_URL=http://143.198.155.67:3000

# Production API keys/secrets (replace with real values)
# PYTORRENT_API_KEY=prod-key

# Centralized service URLs for compose/runtime (use docker hostnames for internal calls OR the public IP if you access them from outside)
FRONTEND_URL=http://143.198.155.67:80
BACKEND_URL=http://143.198.155.67:8080
STREAMING_URL=http://143.198.155.67:3000
TORRENT_API_URL=http://torrent-api:8009