# Example production environment variables for MagnetPlay
# Copy this file to .env.prod and fill with real values. Do NOT commit .env.prod to git.

# Database
POSTGRES_USER=magnetplay
POSTGRES_PASSWORD=change_me_secure_password
POSTGRES_DB=magnetplaydb

# Spring datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/magnetplaydb
SPRING_DATASOURCE_USERNAME=magnetplay
SPRING_DATASOURCE_PASSWORD=change_me_secure_password
SPRING_PROFILES_ACTIVE=production

# JWT / Security
JWT_SECRET=your_jwt_secret_here

# Frontend / Streaming
FRONTEND_URL=http://your.frontend.domain.or.ip
VITE_API_URL=http://your.backend.domain.or.ip:8080
VITE_STREAMING_URL=http://your.streaming.domain.or.ip:3000

# Torrent API
TORRENT_API_URL=http://your.torrent.api:8009

# Postgres configuration for docker image (if used)
POSTGRES_INITDB_ARGS=--encoding=UTF-8
