# Development environment variables for docker-compose (keep private if needed)
# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123sebass
POSTGRES_DB=magnetPlay

# Spring backend datasource (points to the db service)
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/${POSTGRES_DB}
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# Vite frontend dev env (Vite dev server uses .env.development inside frontend, but
# we provide these for convenience or if frontend build uses them)
VITE_API_URL=http://backend:8080
VITE_STREAMING_URL=http://localhost:3000

# Optional API keys for local/dev
# PYTORRENT_API_KEY=dev-key

# Centralized service URLs for prod (internal compose hostnames)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://backend:8080
STREAMING_URL=http://localhost:3000
TORRENT_API_URL=http://torrent-api:8009